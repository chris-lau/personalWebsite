# Application Settings
ENVIRONMENT=development
PORT=8000

# Security & CORS (Comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Third-Party API Keys (Optional locally, recommended for production 5,000 req/hr rate limits)
GITHUB_TOKEN=

# AI Chat — Provider API Keys (Optional; configure at least one to enable the chat widget)
# All three use the OpenAI-compatible SDK; only set the keys for providers you want available.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
CHAT_DEFAULT_MODEL=gemini-2.0-flash
CHAT_RATE_LIMIT_PER_MINUTE=10
# Daily cost-abuse caps (in-memory, reset at UTC midnight; 0 disables).
CHAT_DAILY_GLOBAL_LIMIT=200
CHAT_DAILY_PER_IP_LIMIT=30
